{
  "name": "dsh-proof",
  "version": "0.1.3",
  "description": "Verification gate for DeepSeek Harness: run typecheck/lint/tests after edits, and keep the agent working until they pass.",
  "type": "module",
  "license": "MIT",
  "author": "LordPhenixDeNetra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NetraDevLPDN/dsh-proof.git"
  },
  "homepage": "https://github.com/NetraDevLPDN/dsh-proof#readme",
  "bugs": {
    "url": "https://github.com/NetraDevLPDN/dsh-proof/issues"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "verification",
    "tests",
    "typecheck",
    "guard"
  ],
  "icon": "./public/logo/dsh-proof-icon.png",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/__tests__",
    "!lib/types/__tests__",
    "public/logo/dsh-proof-icon.png",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "PUBLISHING.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test lib/__tests__/*.test.js",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
